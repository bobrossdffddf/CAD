# Discord
DISCORD_TOKEN=your-bot-token
GUILD_ID=123456789012345678
DISPATCH_CHANNEL_ID=123456789012345678
VOICE_CHANNEL_ID=123456789012345678

# STT sidecar
STT_URL=http://127.0.0.1:8077

# Piper TTS (leave blank to disable spoken replies)
PIPER_BIN=/usr/local/bin/piper
PIPER_MODEL=/opt/piper/en_US-lessac-medium.onnx

# ERLC private server API (leave blank to disable game sync)
ERLC_SERVER_KEY=
ERLC_POLL_SECONDS=20

# Voice tuning
WAKE_WORD=dispatch
SILENCE_MS=900
MIN_SEGMENT_MS=400
MAX_SEGMENT_MS=30000
DB_PATH=./cad.sqlite
